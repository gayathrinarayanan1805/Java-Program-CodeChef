import java.util.Scanner;
class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
	    Scanner sc = new Scanner(System.in);
	    int t = sc.nextInt();
	    while(t-->0){
	        int N = sc.nextInt();
	        int M = sc.nextInt();
	        int res = (N/M);
	        if(N%M==0 && res%2==0){
	            System.out.println("Yes");
	        }
	        else{
	            System.out.println("No");
	        }
	    }
	    
		
    }
}
