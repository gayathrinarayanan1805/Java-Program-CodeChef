import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
	    Scanner sc = new Scanner(System.in);
		int t = sc.nextInt();
		while(t-->0)
		{
    		int C = sc.nextInt();
    		if(C>20){
    		    System.out.println("HOT");
    		}
    		else{
    		    System.out.println("COLD");
    		}
    		
		}
		// your code goes here

	}
}
